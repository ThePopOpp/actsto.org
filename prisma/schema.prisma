// ============================================================
// Scholarship
// ============================================================

/// One scholarship application, per student, per school year, per attempt.
///
/// Deliberately holds no award amount. Approval decides *eligibility*; awarding
/// is a separate downstream process on `scholarship_awards`.
model ScholarshipApplication {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId       String  @map("student_id") @db.Uuid
  /// The owning parent/guardian profile. Every scoped query filters on this.
  guardianUserId  String? @map("guardian_user_id") @db.Uuid
  schoolId        String? @map("school_id") @db.Uuid
  /// Free-typed school name when the family picks "Other". Staff reconcile it
  /// against the schools table during review; until then it's what they told us.
  schoolNameOther String? @map("school_name_other")
  schoolYear      String? @map("school_year")

  // ── Step 1: family and student ──────────────────────────────────────────
  grade                 String?
  /// What the family still owes for the year — not the school's published rate.
  tuitionAfterDiscounts Decimal? @map("tuition_after_discounts") @db.Decimal(10, 2)

  // ── Step 2: narrative ───────────────────────────────────────────────────
  narrative String?

  // ── Step 3: household income ────────────────────────────────────────────
  /// Parent affirmed the household figures are current for THIS school year.
  /// Cleared by any subsequent household edit — a stale confirmation is the
  /// exact failure this guards against.
  incomeConfirmedAt DateTime? @map("income_confirmed_at")
  incomeConfirmedBy String?   @map("income_confirmed_by") @db.Uuid
  /// Frozen copy of the household written at submission. Reviewers see what was
  /// certified, not whatever the parent edited afterwards.
  incomeSnapshot    Json?     @map("income_snapshot")

  // ── Step 4: overflow qualification (the parent's *claim*) ───────────────
  /// Slug from OVERFLOW_QUALIFICATIONS. Empty means unanswered; 'none' is the
  /// explicit "doesn't apply" answer and is a real, actionable response. The
  /// default is deliberately *not* 'none' — that would let an unanswered
  /// application read as a genuinely Original-only one.
  overflowQualification String  @default("") @map("overflow_qualification")
  /// Awarding organization — only when qualification = 'prior-award'.
  overflowOrg           String? @map("overflow_org")
  overflowComments      String? @map("overflow_comments")

  // ── Step 5: ESA status ──────────────────────────────────────────────────
  /// 'yes' | 'no' | 'unsure'
  esaCurrentYear String? @map("esa_current_year")
  /// 'yes' | 'no'
  esaPriorYear   String? @map("esa_prior_year")
  /// 'yes' | 'no': has the student received or been awarded a scholarship from
  /// another STO this school year. The amounts are OtherStoScholarship rows.
  otherStoAnswer String? @map("other_sto_answer")

  // ── Student circumstances (shown on the overflow step) ──────────────────
  /// 'yes' | 'no'. Independent of the single-select overflow reason, so a
  /// student who is disabled and also moved from a public school keeps both.
  hasDisability     String? @map("has_disability")
  /// The yes came from picking a disability overflow reason, not from the
  /// parent answering directly. Only an auto-set yes is ever switched back.
  disabilityAutoSet Boolean @default(false) @map("disability_auto_set")
  /// 'yes' | 'no'. K-12 only.
  isDisplaced       String? @map("is_displaced")

  // ── Income proof (low-income eligibility) ───────────────────────────────
  /// not_provided | submitted | accepted | rejected | needs_more
  incomeProofStatus    String    @default("not_provided") @map("income_proof_status")
  incomeProofDecidedBy String?   @map("income_proof_decided_by") @db.Uuid
  incomeProofDecidedAt DateTime? @map("income_proof_decided_at")
  incomeProofNote      String?   @map("income_proof_note")

  // ── Step 6: submission ──────────────────────────────────────────────────
  status           ApplicationStatus @default(draft) @map("application_status")
  certifiedAt      DateTime?         @map("certified_at")
  submittedAt      DateTime?         @map("submitted_at")
  confirmationCode String?           @unique @map("confirmation_code")
  windowId         String?           @map("window_id") @db.Uuid
  /// Set on submit. Non-null means the parent cannot write — checked server-side
  /// on every mutation, not only in the UI.
  lockedAt         DateTime?         @map("locked_at")

  // ── Review workflow ─────────────────────────────────────────────────────
  reviewedBy      String?   @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime? @map("reviewed_at")
  /// Deadline attached to an open request_info. 30 days from the request.
  needsInfoDueAt  DateTime? @map("needs_info_due_at")
  /// Sections reopened by a request_info; everything else stays locked.
  fieldsRequested String[]  @default([]) @map("fields_requested")
  /// Set when staff unlock a submitted application.
  reopenedBy      String?   @map("reopened_by") @db.Uuid
  reopenedAt      DateTime? @map("reopened_at")
  /// True once a needs-info deadline lapsed with no response. Returns the
  /// application to the queue flagged — never auto-denied.
  infoNotReceived Boolean   @default(false) @map("info_not_received")

  // ── Attempt chain (a denied family may reapply in the same year) ─────────
  attemptNumber Int     @default(1) @map("attempt_number")
  supersedesId  String? @map("supersedes_id") @db.Uuid

  /// Superseded by household_members + income_snapshot. Kept for historical
  /// rows only; nothing writes to it.
  requestedAmount      Decimal? @map("requested_amount") @db.Decimal(14, 2)
  householdIncomeRange String?  @map("household_income_range")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  student      Student                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  school       School?                  @relation(fields: [schoolId], references: [id])
  window       ApplicationWindow?       @relation(fields: [windowId], references: [id])
  supersedes   ScholarshipApplication?  @relation("ApplicationChain", fields: [supersedesId], references: [id])
  supersededBy ScholarshipApplication[] @relation("ApplicationChain")
  awards       ScholarshipAward[]
  documents    ApplicationDocument[]
  reviews      ApplicationReview[]
  eligibility  StudentYearEligibility[]

  @@index([guardianUserId])
  @@index([studentId, schoolYear])
  @@index([status])
  @@map("scholarship_applications")
}

/// Household income, owned by the parent — **not** by an application.
///
/// The wizard's financial step and the standalone income page read and write
/// these same rows. Editing in one place must show up in the other.
model HouseholdMember {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId  String  @map("parent_id") @db.Uuid
  fullName  String  @map("full_name")
  /// Free text: "Parent", "Child", "Student · 8th grade".
  roleLabel String? @map("role_label")

  workAmount          Decimal         @default(0) @map("work_amount") @db.Decimal(12, 2)
  workFrequency       IncomeFrequency @default(annually) @map("work_frequency")
  supportAmount       Decimal         @default(0) @map("support_amount") @db.Decimal(12, 2)
  supportFrequency    IncomeFrequency @default(annually) @map("support_frequency")
  retirementAmount    Decimal         @default(0) @map("retirement_amount") @db.Decimal(12, 2)
  retirementFrequency IncomeFrequency @default(annually) @map("retirement_frequency")
  otherAmount         Decimal         @default(0) @map("other_amount") @db.Decimal(12, 2)
  otherFrequency      IncomeFrequency @default(annually) @map("other_frequency")

  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile Profile @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@index([parentId])
  @@map("household_members")
}

/// Supporting documentation for an application (overflow claim, disability,
/// income proof) or for a disability/displacement verification. Exactly one of
/// applicationId and verificationId is set.
/// Private bucket, signed URLs only, purged on a schedule.
model ApplicationDocument {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId  String? @map("application_id") @db.Uuid
  verificationId String? @map("verification_id") @db.Uuid
  storagePath    String  @map("storage_path")
  fileName       String  @map("file_name")
  fileSize       Int     @map("file_size")
  mimeType       String  @map("mime_type")
  /// 'iep' | 'military_orders' | 'esa_closure' | 'enrollment' | 'income_proof'
  /// | 'displaced_form' | 'other'
  documentKind   String  @default("other") @map("document_kind")

  uploadedBy String?   @map("uploaded_by") @db.Uuid
  uploadedAt DateTime  @default(now()) @map("uploaded_at")
  /// Staff confirmed this supports the claimed qualification.
  verifiedAt DateTime? @map("verified_at")
  verifiedBy String?   @map("verified_by") @db.Uuid

  /// Set at upload time from the award year (4-year rule). Null for displaced
  /// forms until the student's final payout year is known. A job purges the
  /// object and sets purgedAt, keeping the row as an audit trail.
  purgeAfter      DateTime? @map("purge_after") @db.Date
  purgedAt        DateTime? @map("purged_at")
  /// 'award_year_4y' | 'displaced_final_payout_4y'
  retentionRule   String    @default("award_year_4y") @map("retention_rule")
  /// Blocks the purge during an audit or dispute, whatever the date.
  legalHold       Boolean   @default(false) @map("legal_hold")
  legalHoldReason String?   @map("legal_hold_reason")

  /// When a denied attempt is superseded, documents relink to the same storage
  /// object rather than asking the family to upload an IEP twice.
  importedFromId String? @map("imported_from_id") @db.Uuid

  application  ScholarshipApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  verification StudentVerification?    @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  accessLogs   DocumentAccessLog[]

  @@index([applicationId])
  @@index([verificationId])
  @@index([purgeAfter])
  @@index([storagePath])
  @@map("application_documents")
}

/// Append-only. Every staff decision writes a row; the application's status is
/// just the latest one. Never overwrite a decision.
model ApplicationReview {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId   String       @map("application_id") @db.Uuid
  reviewerId      String       @map("reviewer_id") @db.Uuid
  action          ReviewAction
  /// Staff eyes only. Never surfaced to the parent, in any view or email.
  internalNote    String?      @map("internal_note")
  /// Sent verbatim to the parent on 'request_info' and 'deny'.
  parentMessage   String?      @map("parent_message")
  /// Which sections reopen on 'request_info'.
  fieldsRequested String[]     @default([]) @map("fields_requested")
  /// request_info only — the deadline as it stood at the time of the action.
  dueAt           DateTime?    @map("due_at")
  createdAt       DateTime     @default(now()) @map("created_at")

  application ScholarshipApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@map("application_reviews")
}

/// The open/close range for a school year. Data, not constants — staff move
/// these dates without a deploy.
model ApplicationWindow {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolYear     String    @unique @map("school_year")
  opensAt        DateTime  @map("opens_at")
  closesAt       DateTime  @map("closes_at")
  /// Drafts already started may still submit until this moment.
  lateGraceUntil DateTime? @map("late_grace_until")
  isPublished    Boolean   @default(false) @map("is_published")

  /// Manual switch on top of the dates. See WindowOverride.
  manualOverride WindowOverride @default(auto) @map("manual_override")
  /// Why it was forced open or closed — shown to staff, never to parents.
  overrideNote   String?        @map("override_note")
  overrideBy     String?        @map("override_by") @db.Uuid
  overrideAt     DateTime?      @map("override_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  applications ScholarshipApplication[]

  @@map("application_windows")
}

/// **The table the awarding process reads.** Eligibility is scoped to the
/// school year of the potential award, never read from application status.
/// Only an approval writes here.
model StudentYearEligibility {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId  String @map("student_id") @db.Uuid
  schoolYear String @map("school_year")

  overflowEligible      Boolean @default(false) @map("overflow_eligible")
  overflowQualification String? @map("overflow_qualification")

  verifiedAt          DateTime @map("verified_at")
  verifiedBy          String   @map("verified_by") @db.Uuid
  sourceApplicationId String   @map("source_application_id") @db.Uuid

  /// Overturning a decision sets this rather than deleting the row. Checked at
  /// award time *and* again at disbursement.
  revokedAt     DateTime? @map("revoked_at")
  revokedReason String?   @map("revoked_reason")
  revokedBy     String?   @map("revoked_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  student           Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sourceApplication ScholarshipApplication @relation(fields: [sourceApplicationId], references: [id])

  @@unique([studentId, schoolYear])
  @@map("student_year_eligibility")
}

/// Who opened which document, and when. If a family asks who saw their child's
/// IEP, this is the answer.
model DocumentAccessLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId    String   @map("document_id") @db.Uuid
  accessedBy    String?  @map("accessed_by") @db.Uuid
  accessorEmail String?  @map("accessor_email")
  /// 'signed_url' | 'download' | 'delete' | 'denied'
  action        String
  ip            String?
  createdAt     DateTime @default(now()) @map("created_at")

  document ApplicationDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt])
  @@map("document_access_log")
}

/// An award (allocation) of one fund's money to one student for one school
/// year. Awards are unlimited; caps and the tuition ceiling apply only to what
/// is sent to the school (ScholarshipPayment). Never deleted: a reversal sets
/// status 'reversed' with a reason.
model ScholarshipAward {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId     String?   @map("application_id") @db.Uuid
  studentId         String    @map("student_id") @db.Uuid
  schoolId          String?   @map("school_id") @db.Uuid
  /// The campaign whose donations this draws from (drives the campaign's funded bar).
  campaignId        String?   @map("campaign_id") @db.Uuid
  /// Drawn from gifts made without a campaign (the general pool). Every award
  /// names a campaign or sets this; an award with neither predates the rule.
  drawsFromGeneral  Boolean   @default(false) @map("draws_from_general")
  /// Lines of one award that was funded from several campaigns share this id.
  allocationGroupId String?   @map("allocation_group_id") @db.Uuid
  /// The committee's decision record for this award (shared by its lines).
  decisionId        String?   @map("decision_id") @db.Uuid
  /// A specific donation this draws from, when the allocator chose one.
  donationId        String?   @map("donation_id") @db.Uuid
  /// Fund the money comes from — same vocabulary as DonationFundSplit.
  fundingSource     String?   @map("funding_source")
  awardAmount       Decimal   @map("award_amount") @db.Decimal(14, 2)
  awardDate         DateTime? @map("award_date") @db.Date
  schoolYear        String?   @map("school_year")
  /// awarded | held_esa | reversed
  status            String    @default("awarded")
  note              String?
  approvedBy        String?   @map("approved_by") @db.Uuid
  createdBy         String?   @map("created_by") @db.Uuid
  createdByEmail    String?   @map("created_by_email")
  heldReason        String?   @map("held_reason")
  holdReleasedAt    DateTime? @map("hold_released_at")
  holdReleasedBy    String?   @map("hold_released_by") @db.Uuid
  holdReleaseNote   String?   @map("hold_release_note")
  reversedAt        DateTime? @map("reversed_at")
  reversedBy        String?   @map("reversed_by") @db.Uuid
  reversalReason    String?   @map("reversal_reason")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  application ScholarshipApplication?   @relation(fields: [applicationId], references: [id])
  student     Student                   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  school      School?                   @relation(fields: [schoolId], references: [id])
  campaign    Campaign?                 @relation(fields: [campaignId], references: [id])
  donation    Donation?                 @relation(fields: [donationId], references: [id])
  decision    ScholarshipAwardDecision? @relation(fields: [decisionId], references: [id])
  payments    ScholarshipPayment[]

  @@index([studentId, schoolYear], map: "scholarship_awards_student_year_idx")
  @@index([fundingSource, schoolYear], map: "scholarship_awards_source_idx")
  @@index([campaignId], map: "scholarship_awards_campaign_idx")
  @@map("scholarship_awards")
}

/// Money sent to the school against an award (a disbursement). Never deleted:
/// a mistake is voided with a reason.
model ScholarshipPayment {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  awardId               String    @map("award_id") @db.Uuid
  schoolId              String?   @map("school_id") @db.Uuid
  amount                Decimal   @db.Decimal(14, 2)
  paymentMethod         String?   @map("payment_method")
  paymentReference      String?   @map("payment_reference")
  paidAt                DateTime? @map("paid_at")
  /// sent | void
  status                String    @default("pending")
  note                  String?
  recordedBy            String?   @map("recorded_by") @db.Uuid
  recordedByEmail       String?   @map("recorded_by_email")
  voidedAt              DateTime? @map("voided_at")
  voidedBy              String?   @map("voided_by") @db.Uuid
  voidReason            String?   @map("void_reason")
  /// Money the school returned (a prorated refund or an excess return). It goes
  /// back on the award, unsent, for the same student or to be reallocated.
  returnedAmount        Decimal   @default(0) @map("returned_amount") @db.Decimal(14, 2)
  returnedAt            DateTime? @map("returned_at")
  returnNote            String?   @map("return_note")
  /// Why staff sent more than tuition room once other STOs' self-reported
  /// scholarships are counted (a warning, not a block).
  tuitionOverrideReason String?   @map("tuition_override_reason")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  award  ScholarshipAward @relation(fields: [awardId], references: [id], onDelete: Cascade)
  school School?          @relation(fields: [schoolId], references: [id])

  @@index([awardId], map: "scholarship_payments_award_id_idx")
  @@map("scholarship_payments")
}

/// Per-student, per-year limits an admin enters. The tuition ceiling defaults
/// to the application's tuition after discounts; ddCap is the disabled/
/// displaced limit (lesser of tuition or 90% of state aid, A.R.S. § 43-1505).
model StudentYearLimit {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId       String   @map("student_id") @db.Uuid
  schoolYear      String   @map("school_year")
  tuitionCeiling  Decimal? @map("tuition_ceiling") @db.Decimal(12, 2)
  tuitionReason   String?  @map("tuition_reason")
  ddCap           Decimal? @map("dd_cap") @db.Decimal(12, 2)
  ddCapReason     String?  @map("dd_cap_reason")
  /// True when staff overrode the matrix cap (reason required). A false row with
  /// a ddCap is an amount typed in before the matrix existed.
  ddCapIsOverride Boolean  @default(false) @map("dd_cap_is_override")
  ddCapDocumentId String?  @map("dd_cap_document_id") @db.Uuid
  updatedBy       String?  @map("updated_by") @db.Uuid
  updatedByEmail  String?  @map("updated_by_email")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, schoolYear], map: "student_year_limits_student_year_key")
  @@map("student_year_limits")
}

/// The low-income income table for one school year (#3). Data, not code:
/// staff enter next year's figures without a deploy.
model LowIncomeTable {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolYear     String   @unique @map("school_year")
  /// [{ householdSize, base185, maxIncome }] for sizes 1–8.
  rows           Json     @default("[]")
  additionalBase Decimal  @default(0) @map("additional_base") @db.Decimal(12, 2)
  additionalMax  Decimal  @default(0) @map("additional_max") @db.Decimal(12, 2)
  sourceNote     String?  @map("source_note")
  updatedBy      String?  @map("updated_by") @db.Uuid
  updatedByEmail String?  @map("updated_by_email")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("low_income_tables")
}

/// Per-student caps on money SENT TO THE SCHOOL, by fund, year and grade band.
model ScholarshipCap {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fundingSource  String   @map("funding_source")
  schoolYear     String   @map("school_year")
  /// k8 (K-8 and preschool with a disability) | 9_12
  gradeBand      String   @map("grade_band")
  amount         Decimal  @db.Decimal(12, 2)
  updatedBy      String?  @map("updated_by") @db.Uuid
  updatedByEmail String?  @map("updated_by_email")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([fundingSource, schoolYear, gradeBand], map: "scholarship_caps_source_year_band_key")
  @@map("scholarship_caps")
}

/// One eligibility flag for one student and school year ('K-12' for displaced,
/// which is verified once). Only `approved` makes a student eligible for the
/// matching restricted fund.
model StudentEligibilityFlag {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId           String    @map("student_id") @db.Uuid
  /// low_income | disabled | displaced | overflow
  flag                String
  schoolYear          String    @map("school_year")
  /// pending_review | awaiting_dcs | info_requested | approved | denied | revoked
  status              String    @default("pending_review")
  /// application | verification | admin_override
  source              String
  sourceApplicationId String?   @map("source_application_id") @db.Uuid
  verificationId      String?   @map("verification_id") @db.Uuid
  documentId          String?   @map("document_id") @db.Uuid
  /// The income calculation, or what a document showed.
  details             Json      @default("{}")
  decidedBy           String?   @map("decided_by") @db.Uuid
  decidedAt           DateTime? @map("decided_at")
  reason              String?
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  student Student                       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  events  StudentEligibilityFlagEvent[]

  @@unique([studentId, flag, schoolYear], map: "student_eligibility_flags_student_flag_year_key")
  @@index([flag, status, schoolYear], map: "student_eligibility_flags_flag_status_idx")
  @@map("student_eligibility_flags")
}

/// Append-only history of a flag.
model StudentEligibilityFlagEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  flagId     String   @map("flag_id") @db.Uuid
  fromStatus String?  @map("from_status")
  toStatus   String   @map("to_status")
  actorId    String?  @map("actor_id") @db.Uuid
  actorEmail String?  @map("actor_email")
  reason     String?
  details    Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  flag StudentEligibilityFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)

  @@index([flagId, createdAt], map: "student_eligibility_flag_events_flag_id_idx")
  @@map("student_eligibility_flag_events")
}

/// A parent's disability or displacement claim made outside an application,
/// or a displacement claim from one. Reviewed in the same queue as
/// applications, labelled by type.
model StudentVerification {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId           String    @map("student_id") @db.Uuid
  /// disability | displacement
  kind                String
  /// School year for disability; 'K-12' for displacement.
  schoolYear          String    @map("school_year")
  /// pending_review | awaiting_dcs | info_requested | approved | denied | withdrawn
  status              String    @default("pending_review")
  /// profile | application
  source              String    @default("profile")
  sourceApplicationId String?   @map("source_application_id") @db.Uuid
  requestedBy         String?   @map("requested_by") @db.Uuid
  parentNote          String?   @map("parent_note")
  claimedBy           String?   @map("claimed_by") @db.Uuid
  claimedAt           DateTime? @map("claimed_at")
  dcsSentAt           DateTime? @map("dcs_sent_at")
  dcsReference        String?   @map("dcs_reference")
  /// What the document showed. Kept after the file itself is purged.
  documentSummary     String?   @map("document_summary")
  // ── Reviewer checklist (disability) ─────────────────────────────────────
  /// IEP | MET | ISP | 504
  documentType        String?   @map("document_type")
  /// Issued by an Arizona public school or district. False means deny.
  issuedByAzPublic    Boolean?  @map("issued_by_az_public")
  disabilityNamed     String?   @map("disability_named")
  /// SPED category code from the 90% state aid matrix; blank for 504 plans.
  spedCategory        String?   @map("sped_category")
  /// preschool | k12, at the time of verification.
  gradeBand           String?   @map("grade_band")
  /// An updated plan for a student already verified: approval updates the
  /// stored details and never removes the existing eligibility.
  isUpdate            Boolean   @default(false) @map("is_update")
  decidedBy           String?   @map("decided_by") @db.Uuid
  decidedAt           DateTime? @map("decided_at")
  parentMessage       String?   @map("parent_message")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  student   Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  documents ApplicationDocument[]
  reviews   VerificationReview[]

  @@index([studentId])
  @@index([status])
  @@map("student_verifications")
}

/// Append-only decision log for a verification.
model VerificationReview {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  verificationId String   @map("verification_id") @db.Uuid
  reviewerId     String?  @map("reviewer_id") @db.Uuid
  reviewerEmail  String?  @map("reviewer_email")
  /// submit | claim | send_to_dcs | approve | deny | request_info | note | parent_upload
  action         String
  internalNote   String?  @map("internal_note")
  parentMessage  String?  @map("parent_message")
  createdAt      DateTime @default(now()) @map("created_at")

  verification StudentVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@index([verificationId, createdAt], map: "verification_reviews_verification_id_idx")
  @@map("verification_reviews")
}

