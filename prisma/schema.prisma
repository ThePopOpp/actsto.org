  /// Ties this row to an entry in lib/email/catalog.ts. Null for ad-hoc templates.
  catalogKey       String?  @unique @map("catalog_key")
  /// transactional | campaign | donation | scholarship | product | marketing
  category         String?
  /// Which role this variant addresses: parent | student | individual_donor | business_donor | all
