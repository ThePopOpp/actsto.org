model ShepardMessage {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  /// user | assistant | tool | system
  role           String
  content        String?
  toolCallsJson  Json?    @map("tool_calls_json")
