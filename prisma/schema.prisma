  /// view | share | like | qr_scan | nfc_tap | link_click | copy_link | save_contact | lead_submit
  eventType  String   @map("event_type")
  source     String?  @default("public_card")
  deviceType String?  @map("device_type")
  referrer   String?
  userAgent  String?  @map("user_agent")
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  card BusinessCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, eventType, createdAt])
  @@map("business_card_events")
}

model BusinessCardLead {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cardId           String   @map("card_id") @db.Uuid
  ownerEmail       String?  @map("owner_email")
  name             String?
  email            String?
  phone            String?
  company          String?
  message          String?
  preferredContact String?  @map("preferred_contact")
  source           String?  @default("public_card")
  /// new | contacted | qualified | archived
  status           String   @default("new")
  payload          Json     @default("{}")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  card BusinessCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, createdAt])
  @@index([ownerEmail, status])
  @@map("business_card_leads")
}

/// Plan Builder — projects/boards owned by a dashboard user (keyed by email).
model Plan {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerEmail  String    @map("owner_email")
  ownerName   String?   @map("owner_name")
  name        String
  description String?
  color       String    @default("gold")
  icon        String    @default("clipboard-list")
  /// board | grid | list | calendar
  defaultView String    @default("board") @map("default_view")
  /// active | archived
  status      String    @default("active")
  /// private | team
  visibility  String    @default("private")
  startDate   DateTime? @map("start_date") @db.Date
  targetDate  DateTime? @map("target_date") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  archivedAt  DateTime? @map("archived_at")

  groups  PlanGroup[]
  labels  PlanLabel[]
  tasks   PlanTask[]
  members PlanMember[]

  @@index([ownerEmail])
  @@map("plans")
}

model PlanGroup {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId    String   @map("plan_id") @db.Uuid
  name      String
  color     String?
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  plan  Plan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  tasks PlanTask[]

  @@index([planId, position])
  @@map("plan_groups")
}

model PlanLabel {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId   String @map("plan_id") @db.Uuid
  name     String
  color    String @default("slate")
  position Int    @default(0)

  plan       Plan            @relation(fields: [planId], references: [id], onDelete: Cascade)
  taskLabels PlanTaskLabel[]

  @@index([planId])
  @@map("plan_labels")
}

model PlanMember {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId    String   @map("plan_id") @db.Uuid
  email     String
  name      String?
  /// owner | editor | member | viewer
  role      String   @default("member")
  createdAt DateTime @default(now()) @map("created_at")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, email])
  @@map("plan_members")
}

model PlanTask {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId      String    @map("plan_id") @db.Uuid
  groupId     String?   @map("group_id") @db.Uuid
  title       String
  description String?
  notes       String?
  /// not_started | in_progress | waiting | blocked | complete
  status      String    @default("not_started")
  /// low | medium | high | urgent
  priority    String    @default("medium")
  progress    Int       @default(0)
  startDate   DateTime? @map("start_date") @db.Date
  dueDate     DateTime? @map("due_date") @db.Date
  isMilestone Boolean   @default(false) @map("is_milestone")
  position    Int       @default(0)
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  plan       Plan                @relation(fields: [planId], references: [id], onDelete: Cascade)
  group      PlanGroup?          @relation(fields: [groupId], references: [id], onDelete: SetNull)
  assignees  PlanTaskAssignee[]
  taskLabels PlanTaskLabel[]
  checklist  PlanChecklistItem[]

  @@index([planId, groupId, position])
  @@map("plan_tasks")
}

model PlanTaskAssignee {
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId String  @map("task_id") @db.Uuid
  email  String
  name   String?

  task PlanTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, email])
  @@map("plan_task_assignees")
}

model PlanTaskLabel {
  taskId  String @map("task_id") @db.Uuid
  labelId String @map("label_id") @db.Uuid

  task  PlanTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label PlanLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@map("plan_task_labels")
}

model PlanChecklistItem {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId     String  @map("task_id") @db.Uuid
  title      String
  isComplete Boolean @default(false) @map("is_complete")
  position   Int     @default(0)

  task PlanTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, position])
  @@map("plan_task_checklist_items")
}

/// Append-only consent audit log — one row per consent action, any channel.
model ConsentEvent {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// email | sms
  channel           String
  /// all | marketing | transactional | donation_updates | campaign_updates
  category          String   @default("all")
  /// opt_in | opt_out | confirmed
  status            String
  previousStatus    String?  @map("previous_status")
  contactName       String?  @map("contact_name")
  email             String?
  phone             String?
  phoneNormalized   String?  @map("phone_normalized")
  userId            String?  @map("user_id") @db.Uuid
  disclosureVersion String   @map("disclosure_version")
  consentText       String   @map("consent_text")
  /// sms_opt_in_page | email_opt_in_page | preferences_center | admin | keyword_stop | webhook | import | email_confirm
  source            String
  sourceUrl         String?  @map("source_url")
  referrer          String?
  ipAddress         String?  @map("ip_address")
  userAgent         String?  @map("user_agent")
  staffActorEmail   String?  @map("staff_actor_email")
  /// Twilio SID / Resend message id, when available
  providerRef       String?  @map("provider_ref")
  evidence          Json     @default("{}")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([channel, createdAt])
  @@index([email])
  @@index([phoneNormalized])
  @@index([userId])
  @@map("consent_events")
}

/// Current effective consent state — one row per (channel, contact).
model ContactConsent {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// email | sms
  channel           String
  /// lowercased email or normalized phone
  contactKey        String    @map("contact_key")
  email             String?
  phone             String?
  phoneNormalized   String?   @map("phone_normalized")
  userId            String?   @map("user_id") @db.Uuid
  contactName       String?   @map("contact_name")
  /// subscribed | unsubscribed | pending
  status            String    @default("subscribed")
  marketing         Boolean   @default(false)
  campaignUpdates   Boolean   @default(true) @map("campaign_updates")
  donationUpdates   Boolean   @default(true) @map("donation_updates")
  /// email double opt-in
  confirmed         Boolean   @default(false)
  confirmToken      String?   @map("confirm_token")
  confirmSentAt     DateTime? @map("confirm_sent_at")
  disclosureVersion String?   @map("disclosure_version")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@unique([channel, contactKey])
  @@index([email])
  @@index([userId])
  @@map("contact_consents")
}

// ============================================================
// Award policy (Oct 16, 2026)
// ============================================================

/// ADOR's 90%-of-state-aid amounts for one school year, by special education
/// category and grade band. The disabled/displaced cap is the lesser of tuition
/// and this amount, across all STOs combined.
model DdCapMatrixRow {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolYear     String   @map("school_year")
  /// A SPED category code, or REG for regular education.
  spedCategory   String   @map("sped_category")
  /// preschool | k8 | 9_12
  gradeBand      String   @map("grade_band")
  amount90pct    Decimal  @map("amount_90pct") @db.Decimal(12, 2)
  updatedBy      String?  @map("updated_by") @db.Uuid
  updatedByEmail String?  @map("updated_by_email")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([schoolYear, spedCategory, gradeBand], map: "dd_cap_matrix_year_category_band_key")
  @@map("dd_cap_matrix_rows")
}

/// Append-only history of the matrix.
model DdCapMatrixEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolYear String   @map("school_year")
  /// import | save | delete
  action     String
  before     Json     @default("[]")
  after      Json     @default("[]")
  actorId    String?  @map("actor_id") @db.Uuid
  actorEmail String?  @map("actor_email")
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([schoolYear, createdAt], map: "dd_cap_matrix_events_year_idx")
  @@map("dd_cap_matrix_events")
}

/// A student's ESA contract status for one school year. An active ESA allows
/// an award but blocks any payment to the school until it is closed.
model StudentEsaStatus {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId         String    @map("student_id") @db.Uuid
  schoolYear        String    @map("school_year")
  /// none | active | closed
  status            String    @default("none")
  closedOn          DateTime? @map("closed_on") @db.Date
  closureDocumentId String?   @map("closure_document_id") @db.Uuid
  note              String?
  /// application | admin
  source            String    @default("application")
  updatedBy         String?   @map("updated_by") @db.Uuid
  updatedByEmail    String?   @map("updated_by_email")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, schoolYear], map: "student_esa_statuses_student_year_key")
  @@map("student_esa_statuses")
}

/// A scholarship from another STO for the same student and year, as the family
/// reported it (or staff corrected it). Counted against tuition and, for
/// disabled/displaced, against the all-STO cap.
model OtherStoScholarship {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId      String   @map("student_id") @db.Uuid
  schoolYear     String   @map("school_year")
  applicationId  String?  @map("application_id") @db.Uuid
  stoName        String   @map("sto_name")
  /// disabled_displaced | low_income | original | switcher | unknown
  program        String   @default("unknown")
  amount         Decimal  @db.Decimal(12, 2)
  /// application | admin
  source         String   @default("application")
  note           String?
  updatedBy      String?  @map("updated_by") @db.Uuid
  updatedByEmail String?  @map("updated_by_email")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, schoolYear], map: "other_sto_scholarships_student_year_idx")
  @@map("other_sto_scholarships")
}

/// The committee's record of one award: need, factors, reviewers, approval and
/// appeals. Required by the award policy filed with ADOR. An award can't be
/// paid until the committee approval is entered.
model ScholarshipAwardDecision {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId       String    @map("student_id") @db.Uuid
  schoolYear      String?   @map("school_year")
  /// { householdIncome, householdSize, pctOfRplLimit, tuition, otherAid, note }
  needAssessment  Json      @default("{}") @map("need_assessment")
  /// { narrative, returning, sibling, waitingList, donorRecommendation, rationale }
  factors         Json      @default("{}")
  /// [{ name, amount, fundingSource }]
  reviewers       Json      @default("[]")
  /// { round, meetingDate, vote, recusals: [{ member, reason }] }
  committee       Json      @default("{}")
  approvedAt      DateTime? @map("approved_at")
  approvedBy      String?   @map("approved_by") @db.Uuid
  approvedByEmail String?   @map("approved_by_email")
  /// When the family was told; appeals are due 30 days after.
  noticeSentAt    DateTime? @map("notice_sent_at")
  /// [{ requestedOn, newInformation, decision, decidedOn }]
  appeals         Json      @default("[]")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  awards ScholarshipAward[]

  @@index([schoolYear], map: "scholarship_award_decisions_year_idx")
  @@map("scholarship_award_decisions")
}

/// Students waiting for Overflow (Switcher) money. Overflow views list them and
/// their siblings first, as A.R.S. § 43-1603 requires.
model OverflowWaitingListEntry {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId      String    @map("student_id") @db.Uuid
  addedOn        DateTime  @default(now()) @map("added_on")
  addedBy        String?   @map("added_by") @db.Uuid
  addedByEmail   String?   @map("added_by_email")
  note           String?
  removedAt      DateTime? @map("removed_at")
  removedByEmail String?   @map("removed_by_email")
  createdAt      DateTime  @default(now()) @map("created_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId], map: "overflow_waiting_list_student_idx")
  @@map("overflow_waiting_list")
}

/// Versions of an admin-edited public page (the award summary). The newest
/// published version is what the public sees; every save is kept.
model PublicPageVersion {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug           String
  title          String
  bodyHtml       String    @map("body_html")
  /// draft | published
  status         String    @default("draft")
  publishedAt    DateTime? @map("published_at")
  createdBy      String?   @map("created_by") @db.Uuid
  createdByEmail String?   @map("created_by_email")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([slug, createdAt], map: "public_page_versions_slug_idx")
  @@map("public_page_versions")
}

/// The full Scholarship Award Policy, one row per uploaded version. Super
/// Admins only; the file is private and served through a short-lived link.
model AwardPolicyDocument {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  versionLabel    String    @map("version_label")
  fileName        String    @map("file_name")
  storagePath     String    @map("storage_path")
  mimeType        String    @map("mime_type")
  sizeBytes       Int       @map("size_bytes")
  adoptedOn       DateTime? @map("adopted_on") @db.Date
  isCurrent       Boolean   @default(false) @map("is_current")
  note            String?
  uploadedBy      String?   @map("uploaded_by") @db.Uuid
  uploadedByEmail String?   @map("uploaded_by_email")
  uploadedAt      DateTime  @default(now()) @map("uploaded_at")

  @@map("award_policy_documents")
}
